# Server-side Resend email delivery (not configured by default)
# Keep the API key server-side. FORM_FROM_EMAIL must use a verified sending domain.
RESEND_API_KEY=
FORM_FROM_EMAIL=Charitr Website <website@send.charitr.in>

# Optional analytics. Scripts load only after analytics consent.
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
